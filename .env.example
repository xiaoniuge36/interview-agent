# Local full-stack defaults only. Copy to .env and rotate every change-me value.
NODE_ENV=development
IMAGE_TAG=local

# PostgreSQL / pgvector
POSTGRES_DB=interview_agent
POSTGRES_USER=interview_agent
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://interview_agent:change-me-local-postgres@127.0.0.1:5432/interview_agent?schema=public

# Redis
REDIS_PASSWORD=change-me-local-redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://:change-me-local-redis@localhost:6379
# REDIS_REQUIRED controls whether /api/health/ready also requires Redis.
# Host development may run without Redis, so the default here is false.
# The Docker Compose stack ships its own Redis and always enforces true.
REDIS_REQUIRED=false

# MinIO
MINIO_ROOT_USER=interview-agent
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_BUCKET=interview-agent-assets
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=interview-agent
MINIO_SECRET_KEY=change-me-in-local-environment
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Product API
API_HOST=0.0.0.0
API_PORT=7101
API_HOST_PORT=7101
API_BODY_LIMIT=1mb
API_CORS_ORIGINS=http://localhost:7100,http://localhost:7102,http://127.0.0.1:7100,http://127.0.0.1:7102,http://localhost:7150
API_SWAGGER_ENABLED=true
API_THROTTLE_TTL_MS=60000
API_THROTTLE_LIMIT=120
# 昂贵 AI 接口（评测/面试命令/补全/检索）单独限流，默认 30 次/窗口
API_AI_THROTTLE_LIMIT=30
AUTH_MODE=jwt_hs256
JWT_SECRET=dev-only-change-me-at-least-32-characters
JWT_ISSUER=interview-agent
JWT_AUDIENCE=interview-agent-web
# Local governance administrator. Required only when AUTH_MODE=jwt_hs256.
LOCAL_ADMIN_EMAIL=admin@interview-agent.local
LOCAL_ADMIN_PASSWORD=change-me-local-admin-password-123
LOCAL_ADMIN_NAME=System Administrator
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=interview-agent-web
AGENT_RUNTIME_URL=http://localhost:7103
AGENT_RUNTIME_TIMEOUT_MS=8000
AGENT_RUNTIME_MAX_ATTEMPTS=2
AGENT_RUNTIME_RETRY_BASE_MS=250
AGENT_RUNTIME_FALLBACK_ENABLED=true
BACKGROUND_JOB_WORKER_ENABLED=false
BACKGROUND_JOB_POLL_INTERVAL_MS=10000
RAG_TRAINING_ENABLED=false
RAG_INTERVIEW_ENABLED=false
RAG_REPORT_ENABLED=false
INTERVIEW_COMMAND_LEASE_MS=360000
INTERNAL_AGENT_TOKEN=dev-internal-agent-token-change-me
# Generate unique 32-byte base64 values for each environment; never reuse these placeholders.
CREDENTIAL_ENCRYPTION_KEY_CURRENT=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
CREDENTIAL_ENCRYPTION_KEY_VERSION=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
AI_CIRCUIT_HALF_OPEN_MAX_PROBES=1

# Agent Runtime
RUNTIME_HOST_PORT=7103
RUNTIME_BODY_LIMIT_BYTES=1048576
RUNTIME_LOG_LEVEL=INFO
AGENT_RUNTIME_MODEL_GATEWAY_URL=http://localhost:7101/api/internal/model-invocations
AGENT_RUNTIME_CHECKPOINT_DATABASE_URL=postgresql://interview_agent:change-me-local-postgres@127.0.0.1:5432/interview_agent?connect_timeout=5

# Frontend authentication
WEB_HOST_PORT=7100
NEXT_PUBLIC_API_BASE_URL=http://localhost:7101/api
NEXT_PUBLIC_APP_NAME=Interview Agent
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_USER_AUTH_MODE=local
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com/
NEXT_PUBLIC_OIDC_CLIENT_ID=interview-agent-web
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:7100/auth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:7100
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

# Admin Console
ADMIN_HOST_PORT=7102
NEXT_PUBLIC_ADMIN_AUTH_MODE=local
NEXT_PUBLIC_ADMIN_OIDC_CLIENT_ID=interview-agent-admin
NEXT_PUBLIC_ADMIN_OIDC_REDIRECT_URI=http://localhost:7102/auth/callback
NEXT_PUBLIC_ADMIN_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:7102

# Observability
PHOENIX_HOST_PORT=6006
PHOENIX_GRPC_HOST_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_UI_URL=http://localhost:6006
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer local-development-only
