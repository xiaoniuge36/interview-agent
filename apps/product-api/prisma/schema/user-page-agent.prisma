model UserAgentConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  messages UserAgentMessage[]
  runs     UserPageAgentRun[]

  @@unique([tenantId, id])
  @@index([tenantId, userId, updatedAt])
}

model UserAgentMessage {
  id             String               @id @default(cuid())
  tenantId       String
  conversationId String
  role           UserAgentMessageRole
  content        String
  tokenCount     Int?
  createdAt      DateTime             @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation UserAgentConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
}

model UserPageAgentRun {
  id              String                 @id @default(cuid())
  tenantId        String
  userId          String
  conversationId  String
  retryOfRunId    String?
  clientRequestId String?
  prompt          String
  status          UserPageAgentRunStatus @default(running)
  currentStep     String?
  tokenCount      Int                    @default(0)
  traceId         String
  errorCode       String?
  errorSummary    String?
  startedAt       DateTime               @default(now())
  finishedAt      DateTime?
  heartbeatAt     DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  conversation UserAgentConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  retryOf      UserPageAgentRun?     @relation("UserPageAgentRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries      UserPageAgentRun[]    @relation("UserPageAgentRunRetries")

  @@unique([tenantId, id])
  @@unique([tenantId, userId, clientRequestId])
  @@index([tenantId, userId, conversationId, startedAt])
  @@index([status, heartbeatAt])
  @@index([retryOfRunId])
}
