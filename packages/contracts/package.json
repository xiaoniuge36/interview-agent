{
  "name": "@interview-agent/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "pretest": "pnpm build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "generate:runtime": "tsx scripts/generate-runtime-schema.ts",
    "check:runtime": "tsx scripts/generate-runtime-schema.ts --check"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "^4.20.3",
    "@types/node": "catalog:"
  }
}
